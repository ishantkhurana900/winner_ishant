# Optional: turns on the AI consultant memo and "Ask One Vision".
# Copy this file to .env and fill in a key. Without a key the dashboard still works; only the AI parts are hidden.
# Any provider with an OpenAI-compatible "chat completions" endpoint works.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Tried once if the main model is busy (optional)
AI_FALLBACK_MODEL=

# Examples
# Google Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.0-flash
# Groq:           AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=llama-3.3-70b-versatile
# OpenRouter:     AI_BASE_URL=https://openrouter.ai/api/v1                             AI_MODEL=openai/gpt-4o-mini
